export CF_API="<%= p('cf.api_url') %>"
export CF_ADMIN_CLIENT="<%= p('cf.admin_client') %>"
export CF_ADMIN_CLIENT_SECRET="<%= p('cf.admin_client_secret') %>"
export CF_ORG="<%= p('cf.org') %>"
export CF_SPACE="<%= p('cf.space') %>"
export SERVICE_OFFERING="<%= p('cf.service_offering_name') %>"
export TLS_SUPPORT="<%= p('tls_support') %>"
export OAUTH_ENFORCED="<%= p('oauth_enforced') %>"
export PATH="$(readlink -f /var/vcap/packages/tanzu-cf-cli-*/bin):${PATH}"

<%
  eligible_plans = p("cf.plans").select do |plan|
    !plan.key?("run_smoke_tests") || plan["run_smoke_tests"] == true
  end
  smoke_test_plans = eligible_plans.map { |plan| plan["name"] }.join(" ")
%>
export SMOKE_TEST_PLANS="<%= smoke_test_plans %>"
